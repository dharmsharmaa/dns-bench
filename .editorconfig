root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# PowerShell convention is four spaces.
[*.ps1]
indent_size = 4

# Markdown: trailing spaces are meaningful (hard line breaks).
[*.md]
trim_trailing_whitespace = false

# Shell: space-indented, matching the existing scripts. Never tabs.
[*.{zsh,sh}]
indent_style = space
indent_size = 2
